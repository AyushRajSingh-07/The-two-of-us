# Two of Us - Private Couples' Sanctuary Environment Variables
# Copy this file to .env to connect to your live Supabase project.
#
# If left blank, the app will automatically run in local sandbox/demo mode
# with reactive cross-tab synchronization and quick partner switching!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
